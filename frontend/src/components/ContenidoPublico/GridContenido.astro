---
import { getCollection } from 'astro:content';
import TarjetaContenido from './TarjetaContenido.astro';

const notas = await getCollection('vault', ({ data }) => data.publicar_web === true);
---

<section id="contenido-publico" class="mx-auto max-w-3xl px-(--spacing-fluid-s) py-(--spacing-fluid-l)">
  <h2 class="text-xl font-semibold text-(--color-texto)">Información del centro</h2>
  <div class="mt-(--spacing-fluid-s) grid grid-cols-1 gap-(--spacing-fluid-s) sm:grid-cols-2">
    {notas.map((nota) => <TarjetaContenido nota={nota} />)}
  </div>
</section>

<script>
  // El chat (isla Preact) despacha este CustomEvent con las fuentes RAG
  // usadas en la última respuesta. La rejilla es contenido estático, así
  // que basta con un listener por DOM en vez de convertirla en isla: solo
  // necesita alternar una clase, no re-renderizar nada.
  type Fuente = { fuente: string; categoria?: string | null };

  window.addEventListener('orquestador:fuentes', (evento) => {
    const fuentes = (evento as CustomEvent<Fuente[]>).detail ?? [];
    const nombres = new Set(fuentes.map((f) => f.fuente));

    document.querySelectorAll<HTMLElement>('[data-fuente]').forEach((tarjeta) => {
      const coincide = nombres.has(tarjeta.dataset.fuente ?? '');
      tarjeta.classList.toggle('destacado', coincide);
      if (coincide) {
        tarjeta.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  });
</script>
