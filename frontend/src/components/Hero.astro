---
import ChatWidget from './chat/ChatWidget';
import { negocio } from '../lib/negocio';

const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? 'http://localhost:8000';
---

<section class="mx-auto max-w-3xl px-(--spacing-fluid-s) py-(--spacing-fluid-l)">
  <div class="text-center">
    <h1 class="text-3xl font-bold text-(--color-texto)">{negocio.nombre}</h1>
    <p class="mt-(--spacing-fluid-2xs) text-(--color-texto-suave)">
      Escríbenos y te ayudamos al momento.
    </p>
  </div>
  <div class="mt-(--spacing-fluid-s)">
    <ChatWidget apiBaseUrl={apiBaseUrl} client:load />
  </div>
</section>
