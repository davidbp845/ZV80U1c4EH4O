# Copia este fichero a .env y rellena los valores reales.
# .env está en .gitignore — nunca se sube al repo.

# Obligatoria: clave de la API de Anthropic
ANTHROPIC_API_KEY=

# Opcional: solo si activas el canal de Telegram (config/business.yaml -> canales.telegram)
TELEGRAM_BOT_TOKEN=

# Opcional: ruta donde persiste la base vectorial de Chroma (por defecto ./chroma_data)
CHROMA_PATH=./chroma_data

# Opcional: pon esto a "true" para usar ProveedorLLMMock en vez de
# ProveedorLLMAnthropic (ver adapters/out/llm_mock.py). Útil para
# desarrollar el frontend u otros clientes del chat sin gastar
# créditos de la API real ni necesitar ANTHROPIC_API_KEY.
USE_MOCK_LLM=
